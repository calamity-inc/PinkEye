<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PinkEye - The Cheat Gold Standard</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #121212;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: #fff;
        }
		
        .container {
            width: 100%;
            max-width: 600px;
            padding: 40px;
            text-align: center;
        }

        .logo {
            width: 200px;
            height: 200px;
            margin: 0 auto 30px;
        }

        .logo img {
			width: 201px;
            height: 215px;
            
			object-fit: contain;
            filter: drop-shadow(0 0 10px rgba(255, 20, 147, 0.5));
			
			border-radius: 20px;
            animation: pulse 2s infinite;
        }

        h1 {
            font-size: 48px;
            margin-bottom: 10px;
            color: #FF1493;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        p {
            font-size: 18px;
            margin-bottom: 40px;
            color: #ccc;
            letter-spacing: 1px;
        }

        .download-btn {
            background-color: #FF1493;
            color: #fff;
            border: none;
            padding: 12px 30px;
            font-size: 18px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 5px;
        }

        .download-btn:hover {
            background-color: #ff47a8;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(255, 20, 147, 0.3);
        }
		
		@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
		
		.cursor {
            display: inline-block;
            width: 10px;
            height: 48px;
            background-color: white;
            animation: blink 1s infinite;
            margin-left: 5px;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
		
		#intro {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 48px;
            text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.7);
            opacity: 1;
            transition: opacity 2s ease;
        }
		
		#main-content {
            /*display: none;*/
            padding: 20px;
        }
    </style>
</head>
<body>
    <div id="main-content" class="container">
        <div class="logo">
            <img src="data:image/gif;base64," alt="PINKEYE Logo">
        </div>
        <h1>PINKEYE</h1>
        <p>THE CHEAT GOLD STANDARD</p>
        <button class="download-btn" onclick="initiateDownload()">Register Now</button>
		<br><br><a style="color: #121212;">The Eye of Battle is always watching...</a>
    </div>
	
	<script>
        function initiateDownload() {
            window.location = "https://stand.sh/account/interest";
        }
    </script>
	
	<!-- <div id="intro">
		<div id="typed-text"></div>
		<div class="cursor"></div>
    </div>

    <script>
        const text = "C5 Technologies";
